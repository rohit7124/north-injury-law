# Copy this file to .env in the backend/ directory and fill in real values.
# Never commit the real .env file.

# Comma-separated list of origins allowed to call this API.
# Include your local dev server and your real Netlify URL.
ALLOWED_ORIGINS=http://localhost:8080,https://your-site.netlify.app

# --- Email notification (optional) ---
# If any of these are left blank, the API will simply skip sending a
# notification email — the lead is still saved to the database either way.
NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Admin lead viewer (optional) ---
# If set, GET /api/leads becomes available to anyone who sends this
# value in an "X-API-Key" header. Leave blank to disable that endpoint
# entirely. Generate a long random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
